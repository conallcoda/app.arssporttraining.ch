{
    "name": "coda/form-kit",
    "description": "Framework-agnostic form field definitions with FluxUI rendering",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Coda\\FormKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coda\\FormKit\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/expression-language": "^7.0 || ^8.0"
    },
    "suggest": {
        "livewire/flux": "Required for Blade view rendering (^2.0)",
        "livewire/flux-pro": "Required for Blade view rendering (^2.0)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coda\\FormKit\\FormKitServiceProvider"
            ]
        }
    }
}
